#include <FastLED.h>
#include "BluetoothSerial.h"

// --- CONFIGURATION ---
#define PIN_RPM      34    // Signal 12V -> Diviseur 3.3V -> Pin 34
#define PIN_LED      2     // Data LEDs
#define NUM_LEDS     9     
#define BRIGHTNESS   150   // Luminosité pour ton impression blanche 6 parois

CRGB leds[NUM_LEDS];
BluetoothSerial SerialBT;

// --- PARAMÈTRES RÉGLABLES ---
int rpmMax = 6000;
int rpmMin = 1500;

volatile int pulseCount = 0;
unsigned long lastMillis = 0;

void IRAM_ATTR countPulse() {
  pulseCount++;
}

void setup() {
  Serial.begin(115200);
  SerialBT.begin("E30_ShiftLight"); 
  
  // Initialisation FastLED
  FastLED.addLeds<WS2812B, PIN_LED, GRB>(leds, NUM_LEDS);
  FastLED.setBrightness(BRIGHTNESS);
  FastLED.clear();
  FastLED.show();
  
  pinMode(PIN_RPM, INPUT_PULLDOWN);
  attachInterrupt(digitalPinToInterrupt(PIN_RPM), countPulse, RISING);
}

void loop() {
  // --- CONTRÔLE BLUETOOTH ---
  if (SerialBT.available()) {
    char cmd = SerialBT.read();
    if (cmd == '+') rpmMax += 100;
    if (cmd == '-') rpmMax -= 100;
    
    SerialBT.print("Nouveau RPM Max : ");
    SerialBT.println(rpmMax);
  }

  unsigned long currentMillis = millis();
  if (currentMillis - lastMillis >= 100) {
    
    noInterrupts();
    int pulses = pulseCount;
    pulseCount = 0;
    interrupts();

    // Calcul M20 (6 cylindres)
    float rpm = pulses * 200.0; 

    // Calcul du nombre de LEDs à allumer
    int ledsToLight = map(rpm, rpmMin, rpmMax, 0, NUM_LEDS);
    ledsToLight = constrain(ledsToLight, 0, NUM_LEDS);

    FastLED.clear();
    for (int i = 0; i < ledsToLight; i++) {
      if (i < 5)      leds[i] = CRGB::Green;  // 5 VERTES
      else if (i == 5) leds[i] = CRGB::Orange; // 1 JAUNE/ORANGE
      else            leds[i] = CRGB::Red;    // 3 ROUGES
    }
    FastLED.show();
    lastMillis = currentMillis;
  }
}
